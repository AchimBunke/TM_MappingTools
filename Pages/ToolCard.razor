<div class="tool-panel @Class">
    <div class="tool-panel-header" style="@(HeaderContent is not null ? "display:flex; align-items:flex-start; justify-content:space-between; gap:0.5rem;" : null)">
        <div>
            <h2 class="tool-panel-title">@Title</h2>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="tool-panel-desc">@Description</p>
            }
        </div>
        @if (HeaderContent is not null)
        {
            <div style="flex-shrink:0;">
                @HeaderContent
            </div>
        }
    </div>
    <div class="tool-panel-body @BodyClass">
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    /// <summary>Extra CSS classes appended to the outer .tool-panel div.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Extra CSS classes appended to the inner body div (alongside tool-panel-body).</summary>
    [Parameter]
    public string? BodyClass { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Optional content rendered at the top-right of the card header (e.g. action buttons).</summary>
    [Parameter]
    public RenderFragment? HeaderContent { get; set; }
}
