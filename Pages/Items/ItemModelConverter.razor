@page "/item-model-converter"
@inherits TM_MappingTools.Pages.SessionStorageComponentBase
@using TM_MappingTools.Services;
@using TM_GenericMapping.Items;
@using TM_GenericMapping.Messaging;
@inject TM_MappingTools.Services.ToolMessageService ToolMessageService


<PageTitle>Item Model Converter</PageTitle>

<ToolPageLayout IconClass="bi-arrow-left-right" Title="Item Model Converter"
                Description="Convert item models for different formats. Create in-game editable, moving, custom gate and other types of items from any input item."
                HelpDescription="What this tool changes and how to tune it safely."
                SidebarStyle="flex: 0 1 clamp(480px, 50vw, 750px); width: clamp(480px, 50vw, 750px);">
    <IORow>
        <ToolIORow>
            <InputContent>
                <ToolCard Title="Item To Convert" Description="Load the item you want to convert.">
                    <FileLoader FileService="ItemFileService" NoFileMessage="No file loaded."
                                DropHintMessage="Drop the item you want to convert here" Accept=".Item.Gbx"
                                AllowMultiple="false" MessageSource="Item Model Converter" />
                </ToolCard>
            </InputContent>
            <ExportContent>
                <ToolCard Title="Export" Class="tool-export-panel" BodyClass="tool-export-panel-body"
                          Description="Export the created item.">
                    <ExportPanel EmptyMessage="Run Execute to generate export content."
                                 DownloadAllFileName="ConvertedItems.zip" Items="_exportItems" />
                </ToolCard>
            </ExportContent>
        </ToolIORow>
    </IORow>
    <Sidebar>
        <ToolCard Title="Mesh Configuration" BodyClass="small">
            <HeaderContent>
                <div class="d-flex justify-content-end mb-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm tool-toggle-btn"
                            enable="@isItemLoaded" disabled="@(!isItemLoaded)" @onclick="() => _showPreview = !_showPreview"
                            title="@(_showPreview ? "Hide mesh preview" : "Show mesh preview")">
                        <span class="bi @(_showPreview ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></span>
                        @(_showPreview ? "Hide Preview" : "Show Preview")
                    </button>
                </div>
            </HeaderContent>
            <ChildContent>
                @if (isItemLoaded)
                {
                    <div class="cfg-table-wrap">
                        <ul class="cfg-table" style="min-width:450px;">
                            <li class="cfg-table-head">
                                <span class="cfg-col-name">Name</span>
                                <span class="cfg-col-type">Type</span>
                                <span class="cfg-col-verts">Verts</span>
                                <span class="cfg-col-check" title="Enabled">En</span>
                                <span class="cfg-col-check" title="Visible">Vis</span>
                                <span class="cfg-col-check" title="Collidable">Col</span>
                                <span class="cfg-col-check" title="Effect Trigger">Eff</span>
                                <span class="cfg-col-check" title="Waypoint Trigger">Way</span>
                                <span class="cfg-col-check" title="Movable">Mov</span>
                            </li>
                            @foreach (var group in GroupedSubMeshes)
                            {
                                <li class="cfg-table-group">Group: @group.Key</li>
                                @foreach (var typeGroup in TypesInGroup(group.Key))
                                {
                                    @foreach (var (index, subMesh) in typeGroup)
                                    {
                                        var cfg = submeshConfigs.GetValueOrDefault(index) ?? new MeshConfig();
                                        var localIndex = index;
                                        <li class="cfg-table-row"
                                            style="@SubmeshRowStyle(cfg.Enabled, localIndex == _selectedSubmeshIndex)" role="button"
                                            @onclick="@(() => _selectedSubmeshIndex = (_selectedSubmeshIndex == localIndex ? (int?)null : localIndex))">
                                            <span class="cfg-col-name text-truncate small" title="@subMesh.Name">@subMesh.Name</span>
                                            <span class="cfg-col-type">@subMesh.Type</span>
                                            <span class="cfg-col-verts">@subMesh.Positions.Length</span>
                                            <div class="cfg-col-check">
                                                <input type="checkbox" checked="@cfg.Enabled"
                                                       @onchange="e => { cfg.Enabled = (bool)e.Value!; ValidateConfiguration(); }"
                                                       @onclick:stopPropagation />
                                            </div>
                                            <div class="cfg-col-check">
                                                <input type="checkbox" checked="@cfg.Visible" disabled="@(!cfg.Enabled)"
                                                       @onchange="e => { cfg.Visible = (bool)e.Value!; ValidateConfiguration(); }"
                                                       @onclick:stopPropagation />
                                            </div>
                                            <div class="cfg-col-check">
                                                <input type="checkbox" checked="@cfg.Collidable" disabled="@(!cfg.Enabled)"
                                                       @onchange="e => { cfg.Collidable = (bool)e.Value!; ValidateConfiguration(); }"
                                                       @onclick:stopPropagation />
                                            </div>
                                            <div class="cfg-col-check">
                                                <input type="checkbox" checked="@cfg.Trigger_Effect" disabled="@(!cfg.Enabled)"
                                                       @onchange="e => { cfg.Trigger_Effect = (bool)e.Value!; ValidateConfiguration(); }"
                                                       @onclick:stopPropagation />
                                            </div>
                                            <div class="cfg-col-check">
                                                <input type="checkbox" checked="@cfg.Trigger_Waypoint" disabled="@(!cfg.Enabled)"
                                                       @onchange="e => { cfg.Trigger_Waypoint = (bool)e.Value!; ValidateConfiguration(); }"
                                                       @onclick:stopPropagation />
                                            </div>
                                            <div class="cfg-col-check">
                                                <input type="checkbox" checked="@cfg.Movable" disabled="@(!cfg.Enabled)"
                                                       @onchange="e => { cfg.Movable = (bool)e.Value!; ValidateConfiguration(); }"
                                                       @onclick:stopPropagation />
                                            </div>
                                        </li>
                                    }
                                }
                            }
                        </ul>
                    </div>
                }
                else if (ItemFileService.Item != null)
                {
                    <div class="text-danger small">Failed to load mesh from item. See output for more details.</div>
                }
            </ChildContent>
        </ToolCard>
        <ToolCard Title="LOD Configuration" BodyClass="small" Collapsible="true" InitiallyCollapsed="true">
            <ChildContent>
                @if (isItemLoaded)
                {
                    @* ── LOD Distances editor ─────────────────────────────── *@
                    <div class="lod-distances-editor">
                        <div style="font-size:0.78em; font-weight:600; color:var(--tm-text-muted); margin-bottom:0.25rem;">
                            LOD Distances — @(itemConfig.LODDistances.Count + 1) LOD level(s)
                        </div>
                        @for (int i = 0; i < itemConfig.LODDistances.Count + 1; i++)
                        {
                            var localI = i;

                            <div class="lod-distance-row">
                                <span class="lod-distance-label">LOD @(localI):&nbsp;&nbsp;&nbsp;@(localI == 0 ? "0" :
                                                                                                    itemConfig.LODDistances[localI - 1])
                        -
                        @(localI < itemConfig.LODDistances.Count ? itemConfig.LODDistances[localI] : "∞")</span>
                        <input type="number" class="form-control form-control-sm lod-distance-input"
                               disabled="@(localI >= itemConfig.LODDistances.Count)" min="0" step="10"
                               value="@(localI < itemConfig.LODDistances.Count ? itemConfig.LODDistances[localI] : 0)"
                               @onchange="e => { if (float.TryParse(e.Value?.ToString(), out var v)) { if (localI < itemConfig.LODDistances.Count) itemConfig.LODDistances[localI] = v; } }" />
                        <span style="font-size:0.8em; color:var(--tm-text-muted);"></span>
                        @if (localI < itemConfig.LODDistances.Count)
                        {
                            <button class="tool-panel-collapse-btn" title="Remove this LOD distance"
                                    @onclick="() => RemoveLodDistance(localI)">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 8 L13 8" />
                                </svg>
                            </button>
                        }
                    </div>
                }
                <button class="btn btn-outline-secondary btn-sm" style="align-self:flex-start; margin-top:0.1rem;"
                        @onclick="AddLodDistance">
                    + Add LOD Distance
                </button>
            </div>
            @* ── LOD mask table ───────────────────────────────────── *@

            <div class="cfg-table-wrap">
                <ul class="cfg-table">
                    <li class="cfg-table-head">
                        <span class="cfg-col-name">Name</span>
                        <span class="cfg-col-verts">Verts</span>
                        <span class="cfg-col-check" title="Has LODs">LOD</span>
                        <span class="cfg-col-check" title="Visible in all LODs">All</span>
                        @for (int lod = 0; lod < itemConfig.LODDistances.Count + 1; lod++)
                        {
                            <span class="cfg-col-check" title="LOD @lod">L@(lod)</span>
                        }
                    </li>
                    @foreach (var group in GroupedSubMeshes)
                    {
                        <li class="cfg-table-group">@group.Key</li>
                        @foreach (var (index, subMesh) in group)
                        {
                            var cfg = submeshConfigs.GetValueOrDefault(index) ?? new MeshConfig();
                            var localIndex = index;
                            bool enabledLOD = cfg.Enabled && cfg.Visible && cfg.HasLOD;
                            var isAllLods = LODUtils.IsVisibleInAllLods(cfg.LODMask, itemConfig.LODDistances.Count + 1);
                            <li class="cfg-table-row"
                                style="@SubmeshRowStyle(enabledLOD, localIndex == _selectedSubmeshIndex)" role="button"
                                @onclick="@(() => _selectedSubmeshIndex = (_selectedSubmeshIndex == localIndex ? (int?)null : localIndex))">
                                <span class="cfg-col-name text-truncate small" title="@subMesh.Name">@subMesh.Name</span>
                                <span class="cfg-col-verts">@subMesh.Positions.Length</span>
                                <div class="cfg-col-check">
                                    <input type="checkbox" checked="@cfg.HasLOD"
                                           @onchange="e => { submeshConfigs[localIndex].HasLOD = (bool)e.Value!; ValidateConfiguration(); }"
                                           @onclick:stopPropagation />
                                </div>
                                <div class="cfg-col-check">
                                    <input type="checkbox" checked="@isAllLods" disabled="@(!enabledLOD)"
                                           @onchange="e => { submeshConfigs[localIndex].LODMask = (bool)e.Value! ? LODUtils.GetAllLodsMask(itemConfig.LODDistances.Count + 1) : 0; ValidateConfiguration(); }"
                                           @onclick:stopPropagation />
                                </div>
                                @for (int lod = 0; lod < itemConfig.LODDistances.Count + 1; lod++)
                                {
                                    var localLod = lod;
                                    <div class="cfg-col-check">
                                        <input type="checkbox" checked="@LODUtils.IsVisibleInLod(cfg.LODMask, localLod)"
                                               disabled="@(!enabledLOD)"
                                               @onchange="e => { submeshConfigs[localIndex].LODMask = ToggleLodBit(submeshConfigs[localIndex].LODMask, localLod, (bool)e.Value!); ValidateConfiguration(); }"
                                               @onclick:stopPropagation />
                                    </div>
                                }
                            </li>
                        }
                    }
                </ul>
            </div>
        }
            else if (ItemFileService.Item != null)
        {
            <div class="text-danger small">Failed to load mesh from item. See output for more details.</div>
        }
    </ChildContent>
</ToolCard>
</Sidebar>
<Main>
    @if (_showPreview)
    {
        <ToolCard Title="Mesh Preview" Description="Click a mesh part in the list or 3D view to select it.">
            <MeshPreviewPanel Item="@(isItemLoaded ? loadedItem : null)" SubmeshConfigs="_previewConfigs"
                              ItemConfig="itemConfig" SelectedSubmeshIndex="_selectedSubmeshIndex"
                              SelectedSubmeshIndexChanged="OnPreviewSubmeshSelected" />
        </ToolCard>
    }
    <ToolCard Title="Actions">
        <ExecuteAction Execute="ExecuteToolAsync" UseSelectedTracks="false" MessageSource="Item Model Converter"
                       ExecutionTargetOverwrite="Generate Converted Items" Tooltip="Execute the tool with the loaded items."
                       CanExecute="CanExecuteTool" ValidationIssues="_validationIssues" />
    </ToolCard>
    <ToolCard Title="Parameters">
        <ParameterInput Definitions="parameterDefinitions" Values="parameterValues"
                        ValuesChanged="OnParameterValuesChanged" />
    </ToolCard>
</Main>
<HelpContent>
    <h3>What happens when you click Execute</h3>
    <p>The tool will convert any item into an item with the specified target type.</p>
    <p>Item != Item in Trackmania, there are differences in how they are structured which matters on the effect it
        has in-game. There are items that are editable in the editor MeshModeler, moving item, checkpoints, effect
        gates, blender exported items, etc. each encodes their respective geometry, collisions and effects slightly
        different.</p>
        <p>This tool allows you to select item geometry, collision shapes, and effects and decide to what output type
            they are converted to. This way you can e.g. convert blender exports to MeshModeler editable items, use
            solid geometry as effect triggers to create custom gates without blender and more.</p>
            <h3>Use Configuration</h3>
            <p>When enabled, the tool will use the configuration you set in the input selection to determine which parts are
                enabled, visible, collidable, trigger and movable. When disabled, the tool will try to figure out a useful
                default configuration for the selected target type.</p>
                <h3>Target Type</h3>
                <p>The target type determines the item type to convert to. It decides what the item can do in-game. General items are items with mixed content containing static, moving, effect triggers or waypoint triggers.
                    MeshModeler items are in-game editable with the MeshModeler tool. MeshModeler items cannot contain moving or effect trigger parts.
                </p>
                    <h3>Gate Gameplay Effect</h3>
                    <p>When the target type is set to Custom Gate, you can select the gameplay effect of the gate.</p>
                    <h3>Waypoint Type</h3>
                    <p>When the target type is set to Crystal Waypoint, you can select the type of waypoint for the crystal item.
                    </p>
                    <h3>Input Selection</h3>
                    <p>An item is deconstructed into its constituent parts, which are separated by material, layers, visual,
                        collision shapes, and triggers.</p>
                        <p>Configure for each part their role in the converted item. Each part can be converted into multiple different
                            output categories, while some categories will be ignored depending on the selected target type.</p>
                            <ul>
                                <li>
                                    <p><strong>Name</strong>: The material name.</p>
                                </li>
                                <li>
                                    <p><strong>Verts</strong>: The number of vertices.</p>
                                </li>
                                <li>
                                    <p><strong>Enabled</strong>: Is it converted or ignored entirely.</p>
                                </li>
                                <li>
                                    <p><strong>Visible</strong>: Is it part of the visible geometry.</p>
                                </li>
                                <li>
                                    <p><strong>Collidable</strong>: Is it part of the collision shape.</p>
                                </li>
                                <li>
                                    <p><strong>Trigger</strong>: Is it part of the trigger shape.</p>
                                </li>
                                <li>
                                    <p><strong>Movable</strong>: Is it part of the movable collision shape.</p>
                                </li>
                            </ul>
                            <h3>LOD Configuration</h3>
                            <p>Edit an item's LOD distances and assign parts to different LOD levels.</p>
                            <p>A LOD (Level of Detail) defines the distance at which different versions of the item's geometry are
                                displayed. <strong>Distance</strong> doesnt mean physical distance from the camera but depends on FOV and
                                size on screen (i think).</p>
                                <p>If you disabled LOD for a part, it will always be rendered regardless of the distance. If its enabled, it
                                    will be rendered based on the specified LOD distances and the LODs it is assigned for. The last LOD is
                                    reserved for every distance greater than the last specified.</p>
                                    <p>Note that removing a LOD level will affect all parts assigned to that and following levels because distance
                                        assignments will shift.</p>
                                        <p>Inside the preview you can enable/disable LODs to see how they affect the rendering of the item.</p>
                                        <p>Not all output types support LOD configuration!</p>
                                        <h3>Practical workflows</h3>
                                        <h7>Example 1: Convert a Blender export static item to an in-game editable item</h7>
                                        <p>A static item exported from Blender has no moving parts and no trigger and is usually a Solid2Model which can
                                            not be edited in the in-game MeshModeler.</p>
                                            <p> To convert them to an in-game editable item, load the item, select the target type <strong>Crystal</strong>
                                                (or <strong>Crystal Waypoint</strong> for waypoints) and enable <strong>Use Configuration</strong>. Select
                                                all meshes which should be converted into geometry layers. If the item contains collision shapes which are
                                                not matched by mesh parts (e.g. invisible collision shapes or boxes around an item for simple collisions)
                                                also enable the static shape part, otherwise disable it as it is just redundant data because it could encode
                                                the same geometry as the mesh.</p>
                                                <h7>Example 2: Convert a MeshModeler item into a Custom Gate</h7>
                                                <p>The MeshModeler allows for the creation of custom gate items so you can create a template item and convert it
                                                    to a Gate here.</p>
                                                    <p>Create a new item in the in-game editor and construct a layer which represents your trigger shape (it doesn't
                                                        matter if it's a trigger layer or not). Load the created item and select <strong>Trigger</strong> for the
                                                        part you want to be recognized as the trigger shape. Disable <strong>Collidable</strong>. If it should
                                                        contain a visible, non-collidable material keep <strong>Visible</strong> enabled. Select
                                                        <strong>CustomGate</strong> as the target type and select your desired <strong>Gate Gameplay
                                                        Effect</strong>.
                                                    </p>
                                                    <p>Execute and test your created gate item. If you want different effects you can use the <strong>Gate Variant
                                                        Creator</strong> to create all gameplay variants.</p>

                                                        <h3>Note</h3>
                                                        <p>It is possible to create configurations that will create invalid items which will crash the editor when
                                                            placed.</p>
                                                            <p><strong>If you encounter such issues and you are sure it should work please reach out to me.</strong></p>
                                                        </HelpContent>
                                                    </ToolPageLayout>


@code {
    [SessionStored] private ItemFileService ItemFileService = default!;

    [SessionStored] private IReadOnlyList<ExportableItem>? _exportItems;
    [SessionStored] private NormalizedItem loadedItem = new();
    [SessionStored] private bool isItemLoaded = false;
    [SessionStored] private Dictionary<int, MeshConfig> submeshConfigs = new();
    [SessionStored] private ItemConfig itemConfig = new();

    private IReadOnlyList<ValidationIssue> _validationIssues = Array.Empty<ValidationIssue>();
    private bool _showPreview = false;
    private int? _selectedSubmeshIndex;
    private IReadOnlyDictionary<int, MeshConfig>? _previewConfigs;


   
    private enum TargetMeshType { General, MeshModeler}

    private IEnumerable<IGrouping<int, (int Index, NormalizedMesh Mesh)>> GroupedSubMeshes =>
        loadedItem.Meshes
            .Select((m, i) => (Index: i, Mesh: m))
            .GroupBy(x => x.Mesh.GroupIndex)
            .OrderBy(g => g.Key);
    private IEnumerable<IGrouping<MeshType, (int Index, NormalizedMesh Mesh)>> TypesInGroup(int groupIndex) =>
        loadedItem.Meshes
            .Select((m, i) => (Index: i, Mesh: m))
            .Where(x => x.Mesh.GroupIndex == groupIndex)
            .GroupBy(x => x.Mesh.Type)
            .OrderBy(g => g.Key);

    private readonly List<ToolParameterDefinition> parameterDefinitions = new()
    {
        new()
        {
            Key = "useConfiguration",
            Label = "Use Configuration",
            Tooltip = "Whether to use the configuration from the input selection for the item.",
            Kind = ToolParameterKind.Bool,
            DefaultValue = true,
        },
        new()
        {
            Key = "targetType",
            Label = "Target Type",
            Tooltip = "The target type of the item. General: All item/mesh types possible. MeshModeler: Ingame editable item.",
            Kind = ToolParameterKind.Enum,
            DefaultValue = "General",
            Options = new[]
    {
                new ToolParameterOption { Value = "General", Label = "General" },
                new ToolParameterOption { Value = "MeshModeler", Label = "MeshModeler" }
    },
        },
        new()
        {
            Key = "gateGameplayEffect",
            Label = "Gate Gameplay Effect",
            Tooltip = "The gameplay effect of the custom gate.",
            Kind = ToolParameterKind.Enum,
            DefaultValue = "Turbo",
            Options = Enum.GetValues<LegacyGameplayId>().Select(v => new ToolParameterOption { Value = v.ToString(), Label = v.ToString() }).ToArray(),
            EnabledWhen = (p)=> Enum.Parse<TargetMeshType>(p.GetString("targetType")) == TargetMeshType.General
        },
        new()
        {
            Key = "waypointType",
            Label = "Waypoint Type",
            Tooltip = "The type of waypoint for the crystal item.",
            Kind = ToolParameterKind.Enum,
            DefaultValue = "None",
            Options = Enum.GetValues<GBX.NET.Engines.GameData.CGameItemModel.EWaypointType>().Select(v => new ToolParameterOption { Value = v.ToString(), Label = v.ToString() }).ToArray(),
        },
    };

    [SessionStored] private ToolParameterValues parameterValues = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();

        ItemFileService.FileChanged += OnFileChanged;

    }
    public void Dispose()
    {
        ItemFileService.FileChanged -= OnFileChanged;
    }
    async void OnFileChanged()
    {
        if (ItemFileService.Item != null)
        {
            _selectedSubmeshIndex = null;
            isItemLoaded = TryLoadMeshFromItem(out loadedItem);
            if (isItemLoaded)
            {
                LoadDefaultConfigurationFromMesh();
            }
        }
        else
        {
            isItemLoaded = false;
            submeshConfigs = new();
            _selectedSubmeshIndex = null;
            _previewConfigs = null;
        }
        await InvokeAsync(StateHasChanged);
    }

    private static string SubmeshRowStyle(bool enabled, bool selected)
    {
        var s = enabled ? "" : "opacity:0.45;";
        if (selected) s += "background:var(--tm-accent-soft,#1a2f4a);border-left:3px solid var(--tm-accent);padding-left:0.25rem;";
        return s;
    }

    private void OnPreviewSubmeshSelected(int? index) => _selectedSubmeshIndex = index;

    private void BuildPreviewConfigs()
    {
        _previewConfigs = submeshConfigs.ToDictionary(entry => entry.Key, entry => entry.Value);
    }
    private Task OnParameterValuesChanged(ToolParameterValues values)
    {
        parameterValues = values;
        ValidateConfiguration();
        return Task.CompletedTask;
    }

    private bool TryLoadMeshFromItem(out NormalizedItem item)
    {
        var extractor = new MeshExtractor();
        var result = extractor.ExtractMesh(ItemFileService.Item!);

        if (result.IsFailure)
        {
            item = default(NormalizedItem)!;
            return false;
        }
        item = result.Value;
        return true;
    }
    private void LoadDefaultConfigurationFromMesh()
    {
        if (!isItemLoaded) return;
        submeshConfigs = new Dictionary<int, MeshConfig>();
        itemConfig = new ItemConfig();
        itemConfig.LODDistances = loadedItem.Groups.FirstOrDefault(g => g.LODDistances.Length > 0)?.LODDistances.ToList() ?? [];

        for (int i = 0; i < loadedItem.Meshes.Length; i++)
        {
            MeshConfig cfg = new MeshConfig();
            var submesh = loadedItem.Meshes[i];
            var group = loadedItem.Groups[submesh.GroupIndex];
            switch (group.GroupType)
            {
                case GroupType.StaticObject:
                    break;
                case GroupType.DynaObject:
                    cfg.Movable = true;
                    break;
                case GroupType.Trigger_Special:
                    cfg.Trigger_Effect = true;
                    break;
                case GroupType.Trigger_Waypoint:
                    cfg.Trigger_Waypoint = true;
                    break;
                default:
                    cfg.Enabled = false;
                    break;
            }
            if (submesh.Properties.HasFlag(MeshProperties.Enabled))
                cfg.Enabled = true;
            if (submesh.Properties.HasFlag(MeshProperties.Visible))
                cfg.Visible = true;
            if (submesh.Properties.HasFlag(MeshProperties.Collidable))
                cfg.Collidable = true;
            if (submesh.Properties.HasFlag(MeshProperties.LOD))
                cfg.HasLOD = true;
            cfg.LODMask = submesh.LODMask;
            submeshConfigs[i] = cfg;
        }
        ValidateConfiguration();
    }

    private void ValidateConfiguration()
    {
        var issues = new List<ValidationIssue>();
        TargetMeshType targetType = Enum.Parse<TargetMeshType>(parameterValues.GetString("targetType"));
        if (!isItemLoaded)
        {
            _validationIssues = issues;
            return;
        }
        BuildPreviewConfigs();
        if (!parameterValues.GetBool("useConfiguration"))
        {
            _validationIssues = issues;
            return;
        }


        var enabledConfigs = submeshConfigs.Where(kv => kv.Value.Enabled).ToList();

        if (enabledConfigs.Count == 0)
        {
            issues.Add(new ValidationIssue(ValidationSeverity.Error, "No submeshes are enabled — the output item will be empty."));
            _validationIssues = issues;
            return;
        }


        bool hasVisible = enabledConfigs.Any(kv => kv.Value.Visible);
        bool hasMovable = enabledConfigs.Any(kv => kv.Value.Movable && kv.Value.Collidable);
        bool hasTrigger = enabledConfigs.Any(kv => kv.Value.Trigger_Waypoint);
        bool hasCollidable = enabledConfigs.Any(kv => kv.Value.Collidable);
        if (itemConfig.LODDistances.Count >= 4)
        {
            issues.Add(new ValidationIssue(ValidationSeverity.Error, "No more than 4 LOD levels are supported — the item will crash the game when placed."));
        }

        if (!hasVisible)
            issues.Add(new ValidationIssue(ValidationSeverity.Warning, "No visible meshes selected — the item will be invisible in-game."));
        switch (targetType)
        {
            case TargetMeshType.MeshModeler:
                if (submeshConfigs.Any(g => g.Value.Trigger_Effect))
                    issues.Add(new ValidationIssue(ValidationSeverity.Warning, "Item contains Effects — Effect trigger will not function in a MeshModeler item."));
                if (submeshConfigs.Any(g => g.Value.Movable))
                    issues.Add(new ValidationIssue(ValidationSeverity.Warning, "Item contains movable parts — Movable parts will not move in a MeshModeler item."));
                break;
        }

        _validationIssues = issues;
    }

    private bool CanExecuteTool()
    {
        return isItemLoaded;
    }
    private async Task<ExecuteActionResult> ExecuteToolAsync()
    {
        var settings = new MeshBuilder.MeshBuilderSettings()
        {
            Author = ItemFileService.Item!.Ident.Author,
        };
        var meshBuilder = new MeshBuilder(settings);

      
        string targetTypeString = parameterValues.GetString("targetType");
        MeshBuilder.BuildSettings buildOptions;
        TargetMeshType targetType = Enum.Parse<TargetMeshType>(targetTypeString);
        if (!parameterValues.GetBool("useConfiguration"))
        {
            buildOptions = MeshBuilder.BuildSettings.DefaultFromMesh(loadedItem);
        }
        else
        {
            var waypointType =
                Enum.Parse<GBX.NET.Engines.GameData.CGameItemModel.EWaypointType>(parameterValues.GetString("waypointType"));
            var effect = Enum.Parse<LegacyGameplayId>(parameterValues.GetString("gateGameplayEffect"));
            buildOptions = CreateBuildOptionsFromConfiguration(targetType, effect, waypointType);
            switch (targetType)
            {
                case TargetMeshType.MeshModeler:
                    buildOptions.TargetModel = MeshBuilder.ItemModel.MeshModeler;
                    break;
                case TargetMeshType.General:
                    buildOptions.TargetModel = MeshBuilder.ItemModel.General;
                    break;
            }
        }
        ToolResult<GBX.NET.Engines.GameData.CGameItemModel> builtItemResult = meshBuilder.BuildItem(loadedItem, buildOptions);

        if (builtItemResult.IsFailure)
        {
            ToolMessageService.AddError($"Failed to build item model: {targetTypeString}", builtItemResult, "Item Model Converter");

            return new ExecuteActionResult(ExecuteActionResultStatus.Failure, $"Failed to build item model: {targetTypeString}");
        }

        
        using var s = new MemoryStream();
        builtItemResult.Value.Save(s, new GBX.NET.GbxWriteSettings { CloseStream = false });
        var bytes = s.ToArray();
        _exportItems = new[] { new ExportableItem { FileName = ItemFileService.FileName, GetBytes = () => bytes } };
        StateHasChanged();
        return new ExecuteActionResult(ExecuteActionResultStatus.Success, Message: $"Item model converted to {targetTypeString}.");
    }

    MeshBuilder.BuildSettings CreateBuildOptionsFromConfiguration(TargetMeshType targetType,
        LegacyGameplayId? legacyGameplayId,
        GBX.NET.Engines.GameData.CGameItemModel.EWaypointType? waypointType)
    {
        var settings = new MeshBuilder.BuildSettings();
        float[] lodDistances = itemConfig.LODDistances.Select(ld => ld / 2f).ToArray();
        MeshBuilder.GroupSetting GetOrCreateMovableGroup(System.Numerics.Vector3 position, System.Numerics.Quaternion rotation)
        {
            if (settings.GroupSettings.Any(gs => gs.Type == GroupType.DynaObject && gs.Position == position && gs.Rotation == rotation))
                return settings.GroupSettings.FirstOrDefault(gs => gs.Type == GroupType.DynaObject && gs.Position == position && gs.Rotation == rotation);
            var loadedItemMovingGroup = loadedItem.Groups.FirstOrDefault(g => g.GroupType == GroupType.DynaObject && g.Position == position && g.Rotation == rotation);
            var group = new MeshBuilder.GroupSetting()
            {
                Type = GroupType.DynaObject,
                GroupId = settings.GroupSettings.Count,
                KinematicConstraint = loadedItemMovingGroup?.KinematicConstraint,
                DynaObjectModelParams = loadedItemMovingGroup?.DynaObjectModelParams,
                RelativeMovingParentGroup = loadedItemMovingGroup?.RelativeMovingParentIndex,
                LODDistances = lodDistances,
                Position = position,
                Rotation = rotation,
            };
            settings.GroupSettings.Add(group);
            return group;
        }
        MeshBuilder.GroupSetting GetOrCreateTriggerEffectGroup(System.Numerics.Vector3 position, System.Numerics.Quaternion rotation)
        {
            if (settings.GroupSettings.Any(gs => gs.Type == GroupType.Trigger_Special && gs.Position == position && gs.Rotation == rotation))
                return settings.GroupSettings.FirstOrDefault(gs => gs.Type == GroupType.Trigger_Special && gs.Position == position && gs.Rotation == rotation);
            var group = new MeshBuilder.GroupSetting()
            {
                Type = GroupType.Trigger_Special,
                GroupId = settings.GroupSettings.Count,
                TriggerGameplayId = legacyGameplayId,
                LODDistances = lodDistances,
                Position = position,
                Rotation = rotation,
            };
            settings.GroupSettings.Add(group);
            return group;
        }
        MeshBuilder.GroupSetting GetOrCreateTriggerWaypointGroup(System.Numerics.Vector3 position, System.Numerics.Quaternion rotation)
        {
            if (settings.GroupSettings.Any(gs => gs.Type == GroupType.Trigger_Waypoint && gs.Position == position && gs.Rotation == rotation))
                return settings.GroupSettings.FirstOrDefault(gs => gs.Type == GroupType.Trigger_Waypoint && gs.Position == position && gs.Rotation == rotation);
            var group = new MeshBuilder.GroupSetting()
            {
                Type = GroupType.Trigger_Waypoint,
                GroupId = settings.GroupSettings.Count,
                WaypointType = (GBX.NET.Engines.Plug.NPlugTrigger_SWaypoint.EGameItemWaypointType?)waypointType,
                LODDistances = lodDistances,
                Position = position,
                Rotation = rotation,
            };
            settings.GroupSettings.Add(group);
            return group;
        }
        MeshBuilder.GroupSetting GetOrCreateStaticGroup(System.Numerics.Vector3 position, System.Numerics.Quaternion rotation)
        {
            if (settings.GroupSettings.Any(gs => gs.Type == GroupType.StaticObject && gs.Position == position && gs.Rotation == rotation))
                return settings.GroupSettings.FirstOrDefault(gs => gs.Type == GroupType.StaticObject && gs.Position == position && gs.Rotation == rotation);
            var group = new MeshBuilder.GroupSetting()
            {
                Type = GroupType.StaticObject,
                GroupId = settings.GroupSettings.Count,
                LODDistances = lodDistances,
                Position = position,
                Rotation = rotation,
            };
            settings.GroupSettings.Add(group);
            return group;
        }
        foreach (var (index, cfg) in submeshConfigs)
        {
            if (!cfg.Enabled)
                continue;
            var originalGroup = loadedItem.Groups[loadedItem.Meshes[index].GroupIndex];
            var originalPosition = originalGroup.Position;
            var originalRotation = originalGroup.Rotation;
            var meshSetting = new MeshBuilder.MeshInstanceSetting()
            {
                MeshIndex = index,
                Visible = cfg.Visible,
                Collidable = cfg.Collidable,
                LODMask = cfg.HasLOD ? cfg.LODMask : null
            };
            if (cfg.Movable)
            {
                var movableGroup = GetOrCreateMovableGroup(originalPosition, originalRotation);
                var movableSetting = meshSetting with
                {
                    Movable = true,
                    GroupId = movableGroup.GroupId
                };
                settings.MeshSettings.Add(movableSetting);
            }
            if (cfg.Trigger_Effect)
            {
                var effectGroup = GetOrCreateTriggerEffectGroup(originalPosition, originalRotation);
                var effectSetting = meshSetting with
                {
                    Trigger = true,
                    GroupId = effectGroup.GroupId
                };
                settings.MeshSettings.Add(effectSetting);
            }
            if (cfg.Trigger_Waypoint)
            {
                var waypointGroup = GetOrCreateTriggerWaypointGroup(originalPosition, originalRotation);
                var effectSetting = meshSetting with
                {
                    Trigger = true,
                    GroupId = waypointGroup.GroupId
                };
                settings.MeshSettings.Add(effectSetting);
            }
            if ((cfg.Collidable || cfg.Visible) && !cfg.Movable)
            {
                var staticGroup = GetOrCreateStaticGroup(originalPosition, originalRotation);
                var staticSetting = meshSetting with
                {
                    GroupId = staticGroup.GroupId
                };
                settings.MeshSettings.Add(staticSetting);
            }
        }
        settings.TargetModel = MeshBuilder.ItemModel.General;
        return settings;
    }

    private void AddLodDistance()
    {
        var last = itemConfig.LODDistances.Count > 0 ? itemConfig.LODDistances[^1] : 0f;
        itemConfig.LODDistances.Add(last + 100f);
        ValidateConfiguration();
    }
    private void RemoveLodDistance(int idx)
    {
        if (idx >= 0 && idx < itemConfig.LODDistances.Count)
        {
            itemConfig.LODDistances.RemoveAt(idx);
            foreach (var kv in submeshConfigs)
            {
                var cfg = kv.Value;
                if (cfg.HasLOD)
                    cfg.LODMask = RemoveLodDistance(cfg.LODMask, idx, itemConfig.LODDistances.Count);
            }
            ValidateConfiguration();
        }
    }

    int RemoveLodDistance(int lodMask, int removeIndex, int lodDistanceCount)
    {
        int newMask = 0;
        int oldLodCount = lodDistanceCount + 2;

        for (int newLod = 0; newLod < oldLodCount - 1; newLod++)
        {
            bool visible;

            if (newLod < removeIndex)
            {
                // Unchanged.
                visible = LODUtils.IsVisibleInLod(lodMask, newLod);
            }
            else if (newLod == removeIndex)
            {
                // Merge the two affected intervals.
                visible =
                    LODUtils.IsVisibleInLod(lodMask, removeIndex) ||
                    LODUtils.IsVisibleInLod(lodMask, removeIndex + 1);
            }
            else
            {
                // Shift remaining intervals down.
                visible = LODUtils.IsVisibleInLod(lodMask, newLod + 1);
            }

            if (visible)
                newMask |= 1 << newLod;
        }

        return newMask;
    }
    private static int ToggleLodBit(int mask, int lod, bool on)
        => on ? mask | (1 << lod) : mask & ~(1 << lod);

    private string SubmeshTypeToString(MeshType type)
    {
        return type.ToString();
    }

