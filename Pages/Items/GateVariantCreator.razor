@page "/gate-variant-creator"
@inherits TM_MappingTools.Pages.SessionStorageComponentBase
@using TM_MappingTools.Services;
@using TM_GenericMapping.Messaging
@using TM_GenericMapping.Items;
@inject TM_MappingTools.Services.ToolMessageService ToolMessageService


<PageTitle>Gate Variant Creator</PageTitle>

<ToolPageLayout IconClass="bi-lightning-charge-fill" Title="Gate Variant Creator"
                Description="Create variants of gate items for every effect."
                HelpDescription="What this tool changes and how to tune it safely.">
    <IORow>
        <ToolIORow>
            <InputContent>
                <ToolCard Title="Source Item" Description="Load a .Item.Gbx files that should become moving items.">
                    <FileLoader FileService="ItemFileService" NoFileMessage="No files loaded."
                                DropHintMessage="Drop the item here you want to create effect variants from" Accept=".Item.Gbx"
                                AllowMultiple="false" MessageSource="Gate Variant Creator" />
                </ToolCard>
            </InputContent>
            <ExportContent>
                <ToolCard Title="Export" Class="tool-export-panel" BodyClass="tool-export-panel-body">
                    <ExportPanel EmptyMessage="Run Execute to generate export content."
                                 DownloadAllFileName="GateVariantItems.zip" Items="_exportItems" />
                </ToolCard>
            </ExportContent>
        </ToolIORow>
    </IORow>
    <Sidebar>
        <ToolCard Title="Input Selection" BodyClass="small text-muted">
            <div>Template item loaded: @(ItemFileService.Item != null ? "Yes" : "No")</div>
        </ToolCard>
    </Sidebar>
    <Main>
        <ToolCard Title="Actions">
            <ExecuteAction Execute="ExecuteToolAsync" UseSelectedTracks="false" MessageSource="Gate Variant Creator"
                           ExecutionTargetOverwrite="Create Gate Variant Items" Tooltip="Execute the tool with the loaded item."
                           CanExecute="CanExecuteTool" />
        </ToolCard>
        <ToolCard Title="Parameters">
            <ParameterInput Definitions="parameterDefinitions" Values="parameterValues"
                            ValuesChanged="OnParameterValuesChanged" />
        </ToolCard>
    </Main>
    <HelpContent>
        <h3>What happens when you click Execute</h3>
        <p>This tool will create variants of the loaded gate item for every effect.</p>
        <p>It updates the gameplay effect, associated effect textures such as Signs, SignOff, SpecialFX, Decal and
            TriggerFX, icon and name.</p>
            <h3>Item Requirements for Blender</h3>
            <ul>
                <li><p><code>_trigger_</code> objects define the zone where the gameplay takes effect.</p></li>
                <li><p>
                    Materials are resolved via their Link, so use TriggerFX, SpecialFX, Sign, SignOff, or Decal
                    links.
                    The material name and the effect of the link (Turbo, Boost, etc.) do not matter.
                </p></li>
            </ul>
            <p>The input <strong>must</strong> be a valid gate item of any effect. Use the ItemTypeConverter if it isn't one
                yet.</p>
                <h3>Practical Workflow</h3>
                <p>Create a gate item first, you can use this tool's ItemTypeConverter to convert most items to gate items (Not only blender but also items created ingame).</p>
                <p>Then load the gate item into this tool and click Execute. The tool will create variants for every effect.</p>
            </HelpContent>
        </ToolPageLayout>

@code {
    [SessionStored] private IReadOnlyList<ExportableItem>? _exportItems;

    private readonly List<ToolParameterDefinition> parameterDefinitions = new()
    {
    };

    [SessionStored] private ToolParameterValues parameterValues = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();

        List<ExportableItem> exportItems = new();
        //AddBundledToolFile(exportItems, "TM_TriggerItemVariantCreator.exe", "Assets.TM_TriggerItemVariantCreator.exe");
        //AddBundledToolFile(exportItems, "README.md", "Assets.README.md");

        _exportItems = exportItems.Count > 0 ? exportItems : null;
        StateHasChanged();
    }
    public void Dispose()
    {
    }

    private void AddBundledToolFile(List<ExportableItem> exportItems, string fileName, string embeddedSuffix)
    {
        return ItemFileService.Item != null;
    }
    private async Task<ExecuteActionResult> ExecuteToolAsync()
    {
        var sourceItem = ItemFileService.Item;
        using var itemStream = ItemFileService.GetDownloadStream();

        var effectVariantCreator = new ItemEffectVariantCreator();
        var result = effectVariantCreator.CreateAllGameplayVariants(itemStream);
        if (result.IsFailure)
        {
            ToolMessageService.AddWarning($"Bundled file '{fileName}' could not be loaded and was not added to export.",
nameof(GateVariantCreator));
            return;
        }

        _exportItems = result.Value.Select((v) =>
        {
            using var memoryStream = new MemoryStream();
            v.itemStream.CopyTo(memoryStream);
            var bytes = memoryStream.ToArray();
            v.itemStream.Dispose();
            if (!effectVariantCreator.TryReplaceEffectInName(ItemFileService.FileName, v.gameplayId, out var exportName))
                exportName = FixFileName(ItemFileService.FileName, v.gameplayId.ToString());
            return new ExportableItem { FileName = exportName, GetBytes = () => bytes };
        }).ToArray();
        StateHasChanged();

        if (result.Value.Length == 0)
            return new ExecuteActionResult(ExecuteActionResultStatus.Failure, $"No variants were created.");
        else
            return new ExecuteActionResult(ExecuteActionResultStatus.Success, $"Successfully created variants.");

    }

    private static byte[]? TryReadEmbeddedBytes(string resourceSuffix)
    {
        var assembly = typeof(Program).Assembly;
        var resourceName = assembly.GetManifestResourceNames()
            .FirstOrDefault(name => name.EndsWith(resourceSuffix, StringComparison.OrdinalIgnoreCase));

        if (resourceName == null)
            return null;

        using var stream = assembly.GetManifestResourceStream(resourceName);
        if (stream == null)
            return null;

        using var ms = new MemoryStream();
        stream.CopyTo(ms);
        return ms.ToArray();
    }
}
