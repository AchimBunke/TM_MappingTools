@page "/moving-item-creator"
@inherits TM_MappingTools.Pages.SessionStorageComponentBase
@using GBX.NET.Engines.GameData
@using GBX.NET.Engines.Meta
@using System.Text
@using System.IO.Compression
@using TM_GenericMapping.Messaging
@using TM_MappingTools.Services

@inject TM_MappingTools.Services.ToolMessageService ToolMessageService


<PageTitle>Moving Item Creator</PageTitle>

<ToolPageLayout IconClass="bi-box-arrow-in-right" Title="Moving Item Creator" Description="Create moving items."
                HelpDescription="What this tool changes and how to tune it safely.">
    <IORow>
        <ToolIORow>
            <InputContent>
                <ToolCard Title="Animation Template (Optional)"
                          Description="Load one .Item.Gbx to copy moving animation data and placement from.">
                    <FileLoader FileService="TemplateItemFileService" NoFileMessage="No template item loaded."
                                DropHintMessage="Drop a .Item.Gbx template item in this area" Accept=".Item.Gbx"
                                MessageSource="Moving Item Creator" />
                </ToolCard>
                <ToolCard Title="Items To Convert"
                          Description="Load all .Item.Gbx files that should become moving items.">
                    <FileLoader FileService="ItemModelsFileService" NoFileMessage="No files loaded."
                                DropHintMessage="Drop all items you want to convert to moving here" Accept=".Item.Gbx"
                                AllowMultiple="true" MessageSource="Moving Item Creator" />
                </ToolCard>
            </InputContent>
            <ExportContent>
                <ToolCard Title="Export" Class="tool-export-panel" BodyClass="tool-export-panel-body" Description="Export the created moving item.">
                    <ExportPanel EmptyMessage="Run Execute to generate export content."
                                 DownloadAllFileName="MovingItems.zip" Items="_exportItems" />
                </ToolCard>
            </ExportContent>
        </ToolIORow>
    </IORow>
    <Sidebar>
        <ToolCard Title="Input Selection" BodyClass="small text-muted">
            <div>Template item loaded: @(TemplateItemFileService.Item != null ? "Yes" : "No")</div>
            <div>Items to convert: @ItemModelsFileService.Files.Count</div>
        </ToolCard>
    </Sidebar>
    <Main>
        <ToolCard Title="Actions">
            <ExecuteAction Execute="ExecuteToolAsync" UseSelectedTracks="false" MessageSource="Moving Item Creator"
                           ExecutionTargetOverwrite="Generate Moving Items" Tooltip="Execute the tool with the loaded items."
                           CanExecute="CanExecuteTool" />
        </ToolCard>
        <ToolCard Title="Parameters">
            <ParameterInput Definitions="ParameterDefinitions" Values="parameterValues"
                            ValuesChanged="OnParameterValuesChanged" />
        </ToolCard>
        <ToolCard Title="Movement" Collapsible="true" InitiallyCollapsed="true"
                  Description="Change how the moving parts move. The values start with the animation template and apply to every moving part of every generated item once you edit them.">
            <MovementEditor Config="Movement" Changed="OnMovementChanged" Reset="ResetMovement"
                            SourceLabel="@MovementSourceLabel" />
        </ToolCard>
        <ToolCard Title="Moving Texture" Collapsible="true" InitiallyCollapsed="true"
                  Description="Animate a texture atlas on the moving parts. The values start with the animation template and apply to every moving part of every generated item once you edit them.">
            <MovingTextureEditor Config="MovingTexture" Changed="OnMovingTextureChanged" Reset="ResetMovingTexture"
                                 SourceLabel="@MovementSourceLabel" />
        </ToolCard>
    </Main>
    <HelpContent>
        <h3>What happens when you click Execute</h3>
        <p>The MovingItemCreator will generate moving items based on the loaded source items and the specified
            parameters. At the end a zip file containing all the generated moving items is downloaded.
        </p>

        <p>The generated moving item animations are based on the <strong>Animation Template Item</strong>
            if it exists, otherwise they will contain a default rotating animation.
        </p>
        <p>The generater will try to create the same properties as the source item (like mesh, materials, etc.)
            but some differences might occur. Some materials might not be visible in moving items. Some moving
            items might contain more vertices and triangles as the source item depending which mesh encoding was
            used.
        </p>
        <p>This is a list of the compatibility of many default materials: <a
            href="https://github.com/AchimBunke/TM_MovingTrackGenerator/wiki">TM_MovingTrackGenerator
            Github</a>.
        </p>
        <h3>Author Name</h3>
        <p>The author name encoded in the moving item.</p>
        <h3>Item Name Postfix</h3>
        <p>The postfix appended to the name of the source item for the generated moving item. This is useful to
            easily distinguish the generated moving items from the source items.
        </p>
        <h3>Item Name Prefix</h3>
        <p>The prefix prepended to the name of the source item for the generated moving item.</p>
        <h3>Use Template Animations</h3>
        <p>Copy the movement and moving texture of the animation template to the generated items. If no template is
            loaded (or this is off) a default movement is used.
        </p>
        <h3>Use Template Icon</h3>
        <p>Use the icon of the template item for the generated items. Otherwise the icon of the source item is kept.</p>
        <h3>Use Template Placement</h3>
        <p>Use the placement settings of the template item.
            Otherwise the placement of the source item is kept.
        </p>
        <h3>Override Dynamic Model Params</h3>
        <p>Enables the dynamic model parameters below. They are written to the dynamic model that is moved by the
            kinematic constraint. While this is off the values of the item/template stay untouched.
        </p>
        <h3>Is Kinematic</h3>
        <p>Whether the dynamic model is moved by its kinematic constraint.</p>
        <h3>Cast Static Shadow</h3>
        <p>Whether the moving model casts a static shadow.</p>
        <h3>Period / Period Max</h3>
        <p>Period of the movement in seconds. Period Max is the upper bound of the period; set it equal to Period for a fixed value.</p>
        <h3>Phase / Phase Max</h3>
        <p>Start offset of the movement between 0 and 1. Phase Max is the upper bound; <code>-1</code> means not set.</p>
        <h3>Texture Id</h3>
        <p>The texture id of the dynamic model.</p>
        <h3>Moving Texture</h3>
        <p><em>Sub textures</em> is the number of textures in the atlas, <em>per line</em> / <em>per column</em> describe its
            layout. <em>Top to bottom</em> counts the texture ids from top to bottom instead of bottom to top.
            Every step shows a texture id for its duration in milliseconds (max. 12 steps). Texture ids outside the
            range use the last texture.
        </p>
        <h3>Practical workflow</h3>
        <p>If you want to copy a specific animation to all moving items, load the item containing those into the 'Animation Template' input.
        </p>
        <p>To fine tune the movement, open the <strong>Movement</strong> card. It starts with the values of the
            template and only overwrites them once you change something. Every animation (translation and
            rotation) has at most 4 steps with an ease, a duration in milliseconds and an optional reverse. The result
            is applied to every moving part of every generated item. <strong>Reset</strong> goes back to the template.
        </p>
        <p>To animate a texture, open the <strong>Moving Texture</strong> card and tick <em>Enable moving texture</em>.
            Describe the texture atlas (number of sub textures, sub textures per line and per column, and whether they are
            counted from top to bottom) and add up to 12 steps, each showing a texture id for a duration in milliseconds.
            Like the movement it starts with the template and is applied to every moving part of every generated item.
            <strong>Note:</strong> this only works for materials that support moving textures (like the classic
            Trackmania 2020 moving items).
        </p>
        <p>In the parameters section, <strong>Override Dynamic Model Params</strong> lets you set the instance parameters of the
            dynamic model that is moved. See the property descriptions above.
        </p>
        <p>Then either drag and drop all items you want to convert to moving, or select them from disk in the
            'Items to Convert' section.
        </p>
        <p>Insert your desired author name and item name prefix and suffix in the parameters section.
            
        </p>
        <p>Wait until you downloaded a zip and extract those files into your Items folder.

        </p>
        <p><strong>Note:</strong> If you create new items that didnt exist when you opened Trackmania, you might
            need to restart the game to see them. To avoid this, instead of creating new files, overwrite
            existing items. Then only the Editor needs to be reopened. (Sometimes this does not work)
        </p>
    </HelpContent>
</ToolPageLayout>

    
@code {
    [SessionStored] private ItemFileService TemplateItemFileService = default!;
    [SessionStored] private FileService ItemModelsFileService = default!;
    [SessionStored] private IReadOnlyList<ExportableItem>? _exportItems;
    [SessionStored] private MovementConfig? movement;
    [SessionStored] private MovingTextureConfig? movingTexture;

    /// <summary>Set to false to hide and ignore the dynamic model instance parameters.</summary>
    private bool UseTemplateMovement => TemplateItemFileService.Item != null && parameterValues.GetBool("useTemplateAnimations", true);
    private string MovementSourceLabel => UseTemplateMovement ? "Movement of the template" : "Default movement";

    /// <summary>The movement values, starting with the template's (or the default) movement.</summary>
    private MovementConfig Movement => movement ??= CreateBaseMovement();

    private MovementConfig CreateBaseMovement()
    {
        NPlugDyna_SKinematicConstraint? constraint = null;
        if (UseTemplateMovement)
            TM_GenericMapping.Items.ItemExtensions.TryGetNPlugDyna_SKinematicConstraint(TemplateItemFileService.Item!, out constraint);

        if(constraint is null)
        {
            constraint = TM_GenericMapping.Templating.GbxTemplateLibrary.CreateKinematicConstraintTemplate().Value;
            constraint.AngleMaxDeg = 0;
            constraint.AngleMinDeg = 0;
            constraint.RotAnimFunc!.SubFuncs = [];

            constraint.TransMin = 0;
            constraint.TransMax = 0;
            constraint.TransAnimFunc!.SubFuncs = [];
        }


        return MovementConfig.FromConstraint(constraint);
    }

    /// <summary>Unedited values follow the template, edited values are kept.</summary>
    private void RefreshBaseMovement()
    {
        if (movement?.Customized != true)
            movement = null;
        if (movingTexture?.Customized != true)
            movingTexture = null;
    }

    private MovingTextureConfig MovingTexture => movingTexture ??= CreateBaseMovingTexture();

    private MovingTextureConfig CreateBaseMovingTexture()
    {
        if (UseTemplateMovement &&
            TM_GenericMapping.Items.ItemExtensions.TryGetNPlugDyna_SKinematicConstraint(TemplateItemFileService.Item!, out var constraint))
            return MovingTextureConfig.FromConstraint(constraint);
        return new MovingTextureConfig();
    }

    private Task OnMovingTextureChanged() => Task.CompletedTask;

    private Task ResetMovingTexture()
    {
        movingTexture = null;
        return Task.CompletedTask;
    }

    private Task OnMovementChanged() => Task.CompletedTask;

    private Task ResetMovement()
    {
        movement = null;
        return Task.CompletedTask;
    }
    
    private readonly List<ToolParameterDefinition> parameterDefinitions = new()
    {
        new()
        {
            Key = "author",
            Label = "Author Name",
            Tooltip = "The author of the moving item.",
            Kind = ToolParameterKind.Text,
            DefaultValue = string.Empty,
        },
        new()
        {
            Key = "namePrefix",
            Label = "Item Name Prefix",
            GroupKey = "affixes",
            GroupLabel = "Prefix / Suffix",
            Tooltip = "The prefix to prepend to the name of the source item.",
            Kind = ToolParameterKind.Text,
            DefaultValue = "",
        },
        new()
        {
            Key = "nameSuffix",
            Label = "Item Name Suffix",
            GroupKey = "affixes",
            Tooltip = "The suffix to append to the name of the source item.",
            Kind = ToolParameterKind.Text,
            DefaultValue = "",
        },
        new()
        {
            Key = "useTemplateAnimations",
            Label = "Use Template Animations",
            Tooltip = "Whether to use the template animations for the moving item if there is one.",
            Kind = ToolParameterKind.Bool,
            DefaultValue = true,
        },
        new()
        {
            Key = "useTemplateIcon",
            Label = "Use Template Icon",
            Tooltip = "Whether to use the icon from the template item for the moving item if there is one. Else it uses the original mesh icon.",
            Kind = ToolParameterKind.Bool,
            DefaultValue = false,
        },
        new()
        {
            Key = "useTemplatePlacement",
            Label = "Use Template Placement",
            Tooltip = "Whether to use the placement parameter from the template item for the moving item if there is one. Else it uses the original mesh placement.",
            Kind = ToolParameterKind.Bool,
            DefaultValue = false,
        }
    };

    private static readonly List<ToolParameterDefinition> instanceParamDefinitions = new()
    {
        new()
        {
            Key = "dynaIsKinematic",
            Label = "Is Moving",
            Tooltip = "Whether the dynamic model is kinematic (moving) or static.",
            Kind = ToolParameterKind.Bool,
            DefaultValue = true,
        },
        new()
        {
            Key = "dynaCastStaticShadow",
            Label = "Cast Static Shadow",
            Tooltip = "Whether the moving item casts a static shadow.",
            Kind = ToolParameterKind.Bool,
            DefaultValue = true,
        },
        new()
        {
            Key = "dynaPeriodSc",
            Label = "Period (s)",
            GroupKey = "dynaPeriod",
            GroupLabel = "Period",
            Kind = ToolParameterKind.Float,
            DefaultValue = 1d,
            VisibleWhenKey ="-",
        },
        new()
        {
            Key = "dynaPeriodScMax",
            Label = "Period Max (s)",
            GroupKey = "dynaPeriod",
            Kind = ToolParameterKind.Float,
            DefaultValue = -1d,
            VisibleWhenKey ="-",
        },
        new()
        {
            Key = "dynaPhase01",
            Label = "Phase (0-1)",
            GroupKey = "dynaPhase",
            GroupLabel = "Phase",
            Kind = ToolParameterKind.Float,
            DefaultValue = -1d,
            VisibleWhenKey ="-",
        },
        new()
        {
            Key = "dynaPhase01Max",
            Label = "Phase Max (0-1)",
            GroupKey = "dynaPhase",
            Kind = ToolParameterKind.Float,
            DefaultValue = -1d,
            VisibleWhenKey ="-",
        },
        new()
        {
            Key = "dynaTextureId",
            Label = "Texture Id",
            Kind = ToolParameterKind.Int,
            DefaultValue = 0,
            VisibleWhenKey ="-",
        },
    };

    private IReadOnlyList<ToolParameterDefinition> ParameterDefinitions =>
        parameterDefinitions.Concat(instanceParamDefinitions).ToList();

    [SessionStored] private ToolParameterValues parameterValues = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();

        ItemModelsFileService.FileChanged += OnFileChanged;
        TemplateItemFileService.FileChanged += OnTemplateChanged;

    }
    public void Dispose()
    {
        ItemModelsFileService.FileChanged -= OnFileChanged;
        TemplateItemFileService.FileChanged -= OnTemplateChanged;
    }
    async void OnTemplateChanged()
    {
        RefreshBaseMovement();
        await InvokeAsync(StateHasChanged);
    }
    async void OnFileChanged()
    {
        await InvokeAsync(StateHasChanged);
    }
    private Task OnParameterValuesChanged(ToolParameterValues values)
    {
        parameterValues = values;
        RefreshBaseMovement();
        return Task.CompletedTask;
    }

    private bool CanExecuteTool()
    {
        return ItemModelsFileService.HasFiles;
    }
    private async Task<ExecuteActionResult> ExecuteToolAsync()
    {
        var sourceAnimationItem = TemplateItemFileService.Item;

        var itemFileService = new ItemFileService();

        var itemParser = new TM_GenericMapping.Items.MeshCompilation.ItemParser();

        var itemCompilerSettings = new TM_GenericMapping.Items.MeshCompilation.ItemCompilerSettings
        {
            Author = parameterValues.GetString("author", "TM_MappingTools.MovingItemCreator"),
        };
        var itemCompiler = new TM_GenericMapping.Items.MeshCompilation.ItemCompiler(itemCompilerSettings);

        TM_GenericMapping.Items.MovingItemCreator.MergeOptions mergeOptions = TM_GenericMapping.Items.MovingItemCreator.MergeOptions.None;
        if (parameterValues.GetBool("useTemplateAnimations", true))
        {
            mergeOptions |= TM_GenericMapping.Items.MovingItemCreator.MergeOptions.UseTemplateAnimations;
        }
        if (parameterValues.GetBool("useTemplateIcon", false))
        {
            mergeOptions |= TM_GenericMapping.Items.MovingItemCreator.MergeOptions.UseTemplateIcon;
        }
        if (parameterValues.GetBool("useTemplatePlacement", false))
        {
            mergeOptions |= TM_GenericMapping.Items.MovingItemCreator.MergeOptions.UseTemplatePlacement;
        }
        var movingItemCreatorSettings = new TM_GenericMapping.Items.MovingItemCreator.MovingItemCreatorSettings
        {
            MovingItemAnimationTemplate = sourceAnimationItem,
            MergeOptions = mergeOptions,
            RotationAnimationCount = movement is {Customized: true} ? movement.Rotation.Steps.Count : mergeOptions.HasFlag(TM_GenericMapping.Items.MovingItemCreator.MergeOptions.UseTemplateAnimations) ? null : 0,
            TranslationAnimationCount = movement is {Customized: true} ? movement.Translation.Steps.Count : mergeOptions.HasFlag(TM_GenericMapping.Items.MovingItemCreator.MergeOptions.UseTemplateAnimations) ? null : 0,
        };
        var movingItemCreator = new TM_GenericMapping.Items.MovingItemCreator(
            itemParser,
            itemCompiler,
            movingItemCreatorSettings);
        
        string namePrefix = parameterValues.GetString("namePrefix", string.Empty);
        string nameSuffix = parameterValues.GetString("nameSuffix", string.Empty);

   
        var generatedItems = new List<(string FileName, CGameItemModel Item)>();

        int numFails = 0;
        int numSuccess = 0;
        foreach (var file in ItemModelsFileService.Files)
        {
            try
            {
                await itemFileService.SetFileAsync(file);
                var item = itemFileService.Item;
                if (item == null)
                {
                    ToolMessageService.AddError($"Failed to load item from file: {file.Name}", "Moving Item Creator");
                    continue;
                }
           
                var movingItemResult = movingItemCreator.CreateMovingItem(item);

                if (movingItemResult.IsFailure)
                {
                    ToolMessageService.AddError($"Failed to create moving item for file: {file.Name}", movingItemResult, "Moving Item Creator");
                    numFails++;
                }
                else
                {
                    if (movement is { Customized: true } &&
                        TM_GenericMapping.Items.ItemExtensions.TryGetAllNPlugDyna_SKinematicConstraints(movingItemResult.Value, out var constraints))
                    {
                        foreach (var constraint in constraints)
                            movement.ApplyTo(constraint);
                    }
                    if (movingTexture is { Customized: true } &&
                        TM_GenericMapping.Items.ItemExtensions.TryGetAllNPlugDyna_SKinematicConstraints(movingItemResult.Value, out var textureConstraints))
                    {
                        foreach (var constraint in textureConstraints)
                            movingTexture.ApplyTo(constraint);
                    }

                    MovingItemInstanceParams.Apply(movingItemResult.Value, new MovingItemInstanceParams.Values(
                        IsKinematic: parameterValues.GetBool("dynaIsKinematic", true),
                        CastStaticShadow: parameterValues.GetBool("dynaCastStaticShadow", true),
                        PeriodSc: parameterValues.GetFloat("dynaPeriodSc", 1),
                        PeriodScMax: parameterValues.GetFloat("dynaPeriodScMax", 1),
                        Phase01: parameterValues.GetFloat("dynaPhase01", -1),
                        Phase01Max: parameterValues.GetFloat("dynaPhase01Max", -1),
                        TextureId: parameterValues.GetInt("dynaTextureId", 0)));
                    
                    movingItemResult.Value.Name = namePrefix + item.Name + nameSuffix;
                    generatedItems.Add((FixFileName(file.Name, namePrefix, nameSuffix), movingItemResult.Value));
                    numSuccess++;
                }
            }
            catch (Exception e)
            {
                ToolMessageService.AddException(e, $"Failed to create moving item for file: {file.Name}", "Moving Item Creator");
                numFails++;
            }
        }
        if (generatedItems.Count > 0)
        {
            _exportItems = generatedItems.Select(x =>
            {
                using var s = new MemoryStream();
                x.Item.Save(s, new GBX.NET.GbxWriteSettings { CloseStream = false });
                var bytes = s.ToArray();
                return new ExportableItem { FileName = x.FileName, GetBytes = () => bytes };
            }).ToArray();
            StateHasChanged();
        }

        if (numFails > 0 && numSuccess > 0)
            return new ExecuteActionResult(ExecuteActionResultStatus.Warning, $"{numSuccess} moving items created successfully, but {numFails} failed. Check output for details.");
        else if (numFails > 0)
            return new ExecuteActionResult(ExecuteActionResultStatus.Failure, $"Failed to create moving items from all files. Check output for details.");
        else
            return new ExecuteActionResult(ExecuteActionResultStatus.Success, $"Successfully created moving items from all files.");
    }

    string FixFileName(string originalName, string prefix, string suffix)
    {
        if (string.IsNullOrEmpty(originalName) || (string.IsNullOrEmpty(suffix) && string.IsNullOrEmpty(prefix)))
            return originalName;

        const string itemsSuffix = ".Item.Gbx";
        if (originalName.EndsWith(itemsSuffix, StringComparison.OrdinalIgnoreCase))
            return prefix + originalName[..^itemsSuffix.Length] + suffix + itemsSuffix;

        return originalName;
    }
}