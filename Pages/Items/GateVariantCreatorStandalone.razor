@page "/gate-variant-creator-standalone"
@inherits TM_MappingTools.Pages.SessionStorageComponentBase
@inject TM_MappingTools.Services.ToolMessageService ToolMessageService


<PageTitle>Gate Variant Creator (Standalone)</PageTitle>

<ToolPageLayout IconClass="bi-lightning-charge-fill" Title="Gate Variant Creator (Standalone)"
                Description="Create variants of gate items for every effect."
                HelpDescription="What this tool changes and how to tune it safely.">
    <IORow>
        <ToolIORow>
            <InputContent>
                <ToolCard Title="Info">
                    <h4>Gate Variant Creator (Standalone)</h4>
                    <p>Source Code: <a href="https://github.com/AchimBunke/TM_TriggerSurfaceMapping" target="_blank"
                                           rel="noopener noreferrer">Gate Variant Creator (Standalone) Github</a>
                    </p>
                    <p>
                        This tool is a C# implementation of
                        <a href="https://openplanet.dev/file/112" target="_blank" rel="noopener noreferrer">Custom
                            Gates</a>
                            (<a href="https://github.com/schadocalex/gbx-py/blob/a140ca0f51664fc2e935f40a74f859672ed99861/custom_gates.py"
                                target="_blank" rel="noopener noreferrer">GitHub</a>) by <strong>schadocalex</strong>.
                        </p>

                        <h5>Item Requirements for Blender</h5>
                        <ul>
                            <li><code>_trigger_</code> objects define the zone where the gameplay takes effect.</li>
                            <li>
                                Materials are resolved via their Link, so use TriggerFX, SpecialFX, Sign, SignOff, or Decal
                                links.
                                The material name and the effect of the link (Turbo, Boost, etc.) do not matter.
                            </li>
                            <li>Export the item as usual.</li>
                            <li>Drag and drop it onto the exe file to create all available effect variants as a zip file.
                            </li>
                        </ul>

                        <h5>Notes</h5>
                        <ul>
                            <li>No guarantee it will work with all items. There is currently a problem with parsing items
                                with trigger effects in GBX.NET.</li>
                                <li>Not all effects have icons, decals, signs, and TriggerFX. For those, either a default one or
                                    a texture from another effect is used.
                                </li>
                             <li>As long as the integrated Gate Variant Creator version on this website works, the standalone version will not be maintained/updated. Use the integrated version instead.</li>
                        </ul>

                            </ToolCard>
                        </InputContent>
