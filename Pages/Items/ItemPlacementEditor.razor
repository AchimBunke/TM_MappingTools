    private void CopyDefaultPlacement(GBX.NET.Engines.GameData.CGameItemModel item)
    {
        var templatePlacement = item.DefaultPlacement!;

        parameterValues.Set("yawOnly", templatePlacement.YawOnly);
        parameterValues.Set("notOnObject", templatePlacement.NotOnObject);
        parameterValues.Set("autoRotation", templatePlacement.AutoRotation);
        parameterValues.Set("switchPivotManually", templatePlacement.SwitchPivotManually);
        parameterValues.Set("pivotSnapDistance", templatePlacement.PivotSnapDistance);

        parameterValues.Set("cubeSize", templatePlacement.CubeSize);
        parameterValues.Set("cubeCenter", templatePlacement.CubeCenter);

        parameterValues.Set("gridSnapHStep", templatePlacement.GridSnapHStep);
        parameterValues.Set("gridSnapHOffset", templatePlacement.GridSnapHOffset);
        parameterValues.Set("gridSnapVStep", templatePlacement.GridSnapVStep);
        parameterValues.Set("gridSnapVOffset", templatePlacement.GridSnapVOffset);

        parameterValues.Set("flyVStep", templatePlacement.FlyVStep);
        parameterValues.Set("flyVOffset", templatePlacement.FlyVOffset);

        parameterValues.SetList("pivotPositions", templatePlacement.PivotPositions?.Select(p=>p.ToVector3()).ToList() ?? []);
        parameterValues.SetList("pivotRotations", templatePlacement.PivotRotations?.Select(q=>q.AsQuaternion()).ToList() ?? []);
    }

    private void CopyItemDefaultPlacement()
    {
        CopyDefaultPlacement(ItemFileService.Item!);
    }
    private void CopyTemplateDefaultPlacement()
    {
        CopyDefaultPlacement(TemplateItemFileService.Item!);
    }

    private void CopyPatchPlacement(GBX.NET.Engines.GameData.CGameItemModel item)
    {
        var templatePlacement = item.DefaultPlacement!;
        var placementClass = templatePlacement.PlacementClass;

        if(placementClass is null)
        {
            patchParameterValues.Set("enabled", false);
            return;
        }
        patchParameterValues.Set("enabled", true);
        patchParameterValues.Set("sizeGroup", placementClass.SizeGroup);
        patchParameterValues.Set("alwaysUp", placementClass.AlwaysUp);

        patchParameterValues.Set("alignToInterior", placementClass.AlignToInterior);
        patchParameterValues.Set("alignToWorldDir", placementClass.AlignToWorldDir);
        patchParameterValues.Set("worldDirection", placementClass.WorldDir.ToVector3());
        patchParameterValues.SetList("compatiblePatchGroups", placementClass.CompatibleGroupsIds ?? []);

        patchLayoutValues.Clear();
        for(int i=0; i < (placementClass.PatchLayouts?.Length ?? 0) ; ++i)
        {
            var patchLayout = placementClass.PatchLayouts![i];
            var patchLayoutValue = new ToolParameterValues();
            patchLayoutValue.Set("itemCount", patchLayout.ItemCount);
            patchLayoutValue.Set("itemSpacing", patchLayout.ItemSpacing);
            patchLayoutValue.Set("fillAlign", (FillAlign)patchLayout.FillAlign);
            patchLayoutValue.Set("fillDir", (FillDir)patchLayout.FillDir);
            patchLayoutValue.Set("normedPos", patchLayout.NormedPos);
            patchLayoutValue.Set("altitude", patchLayout.Altitude);
            patchLayoutValue.SetList("groups", patchLayout.OnlyOnGroups ?? []);
            patchLayoutValues.Add(patchLayoutValue);
        }
    }

    private void CopyItemPatchPlacement()
    {
        CopyPatchPlacement(ItemFileService.Item!);
    }
    private void CopyTemplatePatchPlacement()
    {
        CopyPatchPlacement(TemplateItemFileService.Item!);
    }

    private void CreatePatchLayoutDefinition()
    {
        patchLayoutValues.Add(new());
