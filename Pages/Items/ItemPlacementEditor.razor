    private void RemovePatchLayoutDefinition(int index)
    {
        patchLayoutValues.RemoveAt(index);
    }
    private bool CanExecuteTool()
    {
        return ItemFileService.Item != null;
    }

    private GbxTemplate<GBX.NET.Engines.GameData.CGameItemPlacementParam> CreatePlacementParams()
    {
        GbxTemplate<GBX.NET.Engines.GameData.CGameItemPlacementParam> template;
        bool withClass = patchParameterValues.GetBool("enabled");
        if(withClass)
            template = GbxTemplateLibrary.CreatePlacementParamTemplateWithPlacementClass();
        else
            template = GbxTemplateLibrary.CreatePlacementParamTemplate();

        var paramTemplate = template.Value;

        paramTemplate.YawOnly = parameterValues.GetBool("yawOnly");
        paramTemplate.NotOnObject = parameterValues.GetBool("notOnObject");
        paramTemplate.AutoRotation = parameterValues.GetBool("autoRotation");

        paramTemplate.CubeSize = parameterValues.GetFloat("cubeSize");
        paramTemplate.CubeCenter = parameterValues.GetVector3("cubeCenter", Vector3.Zero);

        paramTemplate.GridSnapHStep = parameterValues.GetFloat("gridSnapHStep");
        paramTemplate.GridSnapHOffset = parameterValues.GetFloat("gridSnapHOffset");
        paramTemplate.GridSnapVStep = parameterValues.GetFloat("gridSnapVStep");
        paramTemplate.GridSnapVOffset = parameterValues.GetFloat("gridSnapVOffset");

        paramTemplate.FlyVStep = parameterValues.GetFloat("flyVStep");
        paramTemplate.FlyVOffset = parameterValues.GetFloat("flyVOffset");     

        paramTemplate.PivotSnapDistance = parameterValues.GetFloat("pivotSnapDistance");
        paramTemplate.SwitchPivotManually = parameterValues.GetBool("switchPivotManually");

        var entries1 = parameterValues.GetListEntries("pivotPositions");
        var entries2 = parameterValues.GetListEntries("pivotRotations");

        paramTemplate.PivotPositions = parameterValues.GetListEntries("pivotPositions").Cast<Vector3>().Select(v=>v.ToVec3()).ToArray();
        paramTemplate.PivotRotations = parameterValues.GetListEntries("pivotRotations").Cast<Quaternion>().Select(q=> new GBX.NET.Quat(q.X,q.Y,q.Z,q.W)).ToArray();

        if(!withClass)
            return template;

        var paramClass = paramTemplate.PlacementClass!;

        paramClass.SizeGroup = patchParameterValues.GetString("sizeGroup");
        paramClass.AlwaysUp = patchParameterValues.GetBool("alwaysUp");

        paramClass.AlignToInterior = patchParameterValues.GetBool("alignToInterior");
        paramClass.AlignToWorldDir = patchParameterValues.GetBool("alignToWorldDir");
        paramClass.WorldDir = patchParameterValues.GetVector3("worldDirection", Vector3.UnitZ);
        paramClass.CompatibleGroupsIds = patchParameterValues.GetListEntries("compatiblePatchGroups").Cast<string>().ToArray();
        List<GBX.NET.Engines.Plug.NPlugItemPlacement_SClass.PatchLayout> patchLayouts = [];
        for(int i=0; i < patchLayoutValues.Count ; ++i)
        {
            var patchLayoutValue = patchLayoutValues[i];
            var patchLayout = new GBX.NET.Engines.Plug.NPlugItemPlacement_SClass.PatchLayout();
            patchLayout.ItemCount = patchLayoutValue.GetInt("itemCount");
            patchLayout.ItemSpacing = patchLayoutValue.GetFloat("itemSpacing");
            patchLayout.FillAlign = (int)patchLayoutValue.GetEnum<FillAlign>("fillAlign", FillAlign.Center);
            patchLayout.FillDir = (int)patchLayoutValue.GetEnum<FillDir>("fillDir", FillDir.Default);
            patchLayout.NormedPos = patchLayoutValue.GetFloat("normedPos");
            patchLayout.Altitude = patchLayoutValue.GetFloat("altitude");
            patchLayout.OnlyOnGroups = patchLayoutValue.GetListEntries("groups").Cast<string>().ToArray();
            patchLayouts.Add(patchLayout);
        }
        paramClass.PatchLayouts = patchLayouts.ToArray();
        return template;
    }
    private async Task<ExecuteActionResult> ExecuteToolAsync()
    {


        var item =  ItemFileService.Item!;
        item.DefaultPlacement = CreatePlacementParams();
        using var s = new MemoryStream();
        item.Save(s, new GBX.NET.GbxWriteSettings { CloseStream = false });
        var bytes = s.ToArray();
        _exportItems = [ new ExportableItem { FileName = ItemFileService.FileName, GetBytes = () => bytes }];

        await InvokeAsync(StateHasChanged);

        return new ExecuteActionResult(ExecuteActionResultStatus.Success, "Modified placement parameters");
    }
}