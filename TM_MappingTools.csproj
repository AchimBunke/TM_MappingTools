<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <WasmBuildNative>true</WasmBuildNative>
    <BlazorWasmPrerenderingPathBase>/TM_MappingTools/</BlazorWasmPrerenderingPathBase>
    <BlazorWasmPrerenderingDeleteLoadingContents>true</BlazorWasmPrerenderingDeleteLoadingContents>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="BlazorWasmPreRendering.Build" Version="8.1.0-preview.4" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.5" PrivateAssets="all" />

  </ItemGroup>


  <ItemGroup>
    <Folder Include="Assets\" />
    <Folder Include="Model\" />
    <Folder Include="Services\" />
    <Folder Include="Utils\" />
  </ItemGroup>

<ItemGroup>
  <Content Update="wwwroot\Assets\TM_TriggerItemVariantCreator.exe">
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    <BlazorWebAssemblyIntegrityCheck>false</BlazorWebAssemblyIntegrityCheck>
  </Content>
</ItemGroup>

<ItemGroup>
  <ProjectReference Include="..\..\..\TM_Projects\TM_GenericMapping\TM_GenericMapping.csproj" />
</ItemGroup>

</Project>
